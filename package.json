{
  "name": "sthayu-ventures",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run server\" \"npm run dev:client\"",
    "dev:client": "vite --host 0.0.0.0 --port 3000",
    "dev:full": "concurrently -k -p \"[{name}]\" -n \"API,CLIENT\" -c \"yellow.bold,cyan.bold\" \"npm run server\" \"npm run dev:client\"",
    "server": "node server/server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.185.4",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "hls.js": "^1.7.1",
    "lucide-react": "^0.460.0",
    "mongoose": "^9.9.4",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "vite": "^8.2.0"
  }
}
