# ====================================================================
# STHAYU VENTURES - BACKEND CONFIGURATION
# ====================================================================

# MongoDB Atlas Connection String
# Replace with your actual MongoDB Atlas connection URI:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sthayu_ventures?retryWrites=true&w=majority

# Backend Server Port (defaults to 5000 if not specified)
PORT=5000

# Allowed CORS Origins (comma-separated if multiple)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:3000

# Optional: Environment mode ('development' or 'production')
NODE_ENV=development
